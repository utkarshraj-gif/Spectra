# ==========================================
# SPECTRA ENVIRONMENT CONFIGURATION TEMPLATE
# ==========================================

# --- Core Backend (Go + Gin) ---
PORT=8080
GIN_MODE=release
DATABASE_URL=postgres://postgres:postgres@localhost:5432/spectra?sslmode=disable
WORKER_SERVICE_URL=http://localhost:5001
AI_SERVICE_URL=http://localhost:8000
RECORDINGS_PATH=./recordings
DEFAULT_BOT_NAME="Spectra Bot (AI Notetaker)"

# --- Meeting Worker (Playwright Headless Chromium) ---
PORT=5001
ADMISSION_TIMEOUT_MS=120000
# Leave HEADLESS unset for platform defaults (visible Chrome on Windows).
# HEADLESS=true

# --- AI Service (FastAPI + Faster-Whisper) ---
WHISPER_MODEL=base
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8

# --- Database (PostgreSQL 16) ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=spectra
POSTGRES_PORT=5432

# --- Google OAuth & Calendar (Mani's Ownership) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URL=http://localhost:8080/api/auth/google/callback

# --- Frontend (SvelteKit) ---
VITE_API_URL=http://localhost:8080
